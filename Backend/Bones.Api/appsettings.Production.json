{
  "Serilog": {
    "MinimumLevel": "Information"
  },
  "Kestrel": {
    "Endpoints": {
      "HttpsWithCert": {
        "Url": "https://api.",
        "SslProtocols": ["Tls12", "Tls13"],
        "HttpProtocols": "Http1AndHttp2"
      }
    },
    "Certificates": {
      "Default": {
        "Path": "your_path/fullchain.pem",
        "KeyPath": "your_path/privkey.pem"
      }
    }
  },
  "ApiConfiguration": {
    "CorsAllowedOrigins": [
      "https://",
      "http://api."
    ]
  },
  "BackendConfiguration": {
    "WebUIBaseUrl" : "https://"
  },
  "DatabaseConfiguration": {
    "ConnectionString": "",
    "UseInMemoryDb": false
  }
}
