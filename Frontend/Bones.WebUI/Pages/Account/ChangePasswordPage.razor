@attribute [Route(FrontEndUrls.Account.CHANGE_PASSWORD)]

<MudText Typo="Typo.h4">Change my Password</MudText>
<MudGrid>
    <MudItem xs="12" sm="7">
        <MudPaper Class="pa-4">
            <MudForm @bind-IsValid="@FormValid" @bind-Errors="@ValidationErrors">
                <BonesTextField Label="Current Password" InputType="InputType.Password" Required="true" @bind-value="@CurrentPassword"/>
                <BonesTextField Label="New Password" InputType="InputType.Password" Required="true" @bind-value="@NewPassword"/>
                <BonesTextField Label="New Password (again)" InputType="InputType.Password" Required="true" @bind-value="@NewPasswordAgain"/>
                <MudCheckBox T="bool" Label="Invalidate other sessions?" @bind-value="@InvalidateOtherSessions"/>

                <div style="align-self: end;">
                    <br />
                    <a onclick="history.back();">
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary">Go back</MudButton>
                    </a>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!FormValid)" Class="ml-auto" OnClick="@ChangePasswordAsync">Change password</MudButton>
                </div>
            </MudForm>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="5">
        <MudItem Class="pa-2">
            @foreach (string error in ValidationErrors)
            {
                <MudAlert Severity="Severity.Error">@error</MudAlert>
            }
        </MudItem>
    </MudItem>
</MudGrid>