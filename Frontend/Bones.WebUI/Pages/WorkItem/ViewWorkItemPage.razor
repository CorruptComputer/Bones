@using Bones.WebUI.Models
@using Bones.WebUI.Components.Item
@attribute [Route(FrontEndUrls.WorkItem.VIEW_WORK_ITEM)]

<MudText Typo="Typo.h4">@_workItemTitle (v@_currentVersion)</MudText>

<MudGrid>
    <MudItem xs="12" sm="7">
        <MudPaper Class="pa-4">
            <ItemEditor ItemId="@WorkItemId" ItemType="ItemLayoutUse.WorkItems" EditorMode="ItemEditor.Mode.ViewEdit" />
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="5">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6">Queue</MudText>
            <MudTextField T="string" Label="Name" Value="@_queueName" ReadOnly />
            <MudTextField T="string" Label="Added to queue time" Value="@_addedToQueueDateTime" ReadOnly />
            @if (_moveToQueue)
            {
                @if (_moveToQueue)
                {

                    <MudSelect ValueChanged="OnSelectedInitiativeChanged"
                                    Label="Select Initiative"
                                    MultiSelection="false"
                                    FullWidth="true"
                                    T="Guid?">

                        <MudSelectItem Value="@((Guid?)null)" Disabled="true" Style="height: 1px; margin: 0; padding: 0;"></MudSelectItem>
                        @foreach (DropDownModel initiative in _initiatives)
                        {
                            <MudSelectItem Value="@initiative.Id">@initiative.ToString()</MudSelectItem>
                        }
                    </MudSelect>

                    @if (_selectedInitiative != null)
                    {
                        <MudSelect ValueChanged="OnSelectedWorkItemQueueChanged"
                                    Label="Select Work Item Queue"
                                    MultiSelection="false"
                                    FullWidth="true"
                                    T="Guid?">

                            <MudSelectItem Value="@((Guid?)null)" Disabled="true" Style="height: 1px; margin: 0; padding: 0;"></MudSelectItem>
                            @foreach (DropDownModel workItemQueue in _workItemQueues)
                            {
                                <MudSelectItem Value="@workItemQueue.Id">@workItemQueue.ToString()</MudSelectItem>
                            }
                        </MudSelect>

                        @if (_selectedNewWorkItemQueue != null)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SendMoveToQueueRequestAsync">Move to Queue</MudButton>
                        }
                    }
                }

                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => _moveToQueue = false)">Cancel Move to Queue</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => _moveToQueue = true)">Move to Queue</MudButton>
            }
        </MudPaper>
    </MudItem>

</MudGrid>