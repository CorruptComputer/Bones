@attribute [Route(FrontEndUrls.WorkItem.CREATE_WORK_ITEM)]

<MudText Typo="Typo.h4">Create Work Item</MudText>

<MudGrid>
    <MudItem xs="12" sm="7">
        <MudPaper Class="pa-4">
            @if (!WorkItemQueueIdProvidedInQueryString)
            {
                <MudSelect ValueChanged="OnSelectedProjectChanged"
                           Label="Select Project"
                           MultiSelection="false"
                           FullWidth="true"
                           T="Guid?">
                    
                    <MudSelectItem Value="@((Guid?)null)" Disabled="true" Style="height: 1px; margin: 0; padding: 0;"></MudSelectItem>
                    @foreach (DropDownModel proj in Projects)
                    {
                        <MudSelectItem Value="@proj.Id">@proj.ToString()</MudSelectItem>
                    }
                </MudSelect>

                if (SelectedProject != null)
                {
                    <MudSelect ValueChanged="OnSelectedInitiativeChanged"
                               Label="Select Initiative"
                               MultiSelection="false"
                               FullWidth="true"
                               T="Guid?">
                        
                        <MudSelectItem Value="@((Guid?)null)" Disabled="true" Style="height: 1px; margin: 0; padding: 0;"></MudSelectItem>
                        @foreach (DropDownModel initiative in Initiatives)
                        {
                            <MudSelectItem Value="@initiative.Id">@initiative.ToString()</MudSelectItem>
                        }
                    </MudSelect>

                    if (SelectedInitiative != null)
                    {
                        <MudSelect ValueChanged="OnSelectedWorkItemQueueChanged"
                                   Label="Select Work Item Queue"
                                   MultiSelection="false"
                                   FullWidth="true"
                                   T="Guid?">
                            
                            <MudSelectItem Value="@((Guid?)null)" Disabled="true" Style="height: 1px; margin: 0; padding: 0;"></MudSelectItem>
                            @foreach (DropDownModel workItemQueue in WorkItemQueues)
                            {
                                <MudSelectItem Value="@workItemQueue.Id">@workItemQueue.ToString()</MudSelectItem>
                            }
                        </MudSelect>
                    }
                }
            }
            else 
            {
                <MudTextField T="string" Label="Work Item Queue Name" Disabled @bind-Value="@WorkItemQueueName"/>
            }
            
            @if (SelectedWorkItemQueue != null) 
            {
                
                    <MudSelect ValueChanged="OnSelectedLayoutChanged"
                               Label="Select Work Item Layout"
                               MultiSelection="false"
                               FullWidth="true"
                               T="Guid?">
                        
                        <MudSelectItem Value="@((Guid?)null)" Disabled="true" Style="height: 1px; margin: 0; padding: 0;"></MudSelectItem>
                        @foreach (DropDownModel itemLayout in WorkItemLayouts)
                        {
                            <MudSelectItem Value="@itemLayout.Id">@itemLayout.ToString()</MudSelectItem>
                        }
                    </MudSelect>

                
            }
        </MudPaper>
        <br />
        <br />
        @if(SelectedWorkItemLayout != null && _currentLayoutVersionFields.Any())
        {
            <MudPaper Class="pa-4">
                <MudForm @bind-IsValid="@FormValid" @bind-Errors="@ValidationErrors">
                    @foreach (GetLatestItemLayoutVersionFieldsResponse field in _currentLayoutVersionFields)
                    {
                        @switch (field.Type)
                        {
                            case Bones.Api.Client.FieldType.TextField:
                                <MudTextField T="string" Label="@field.Name" Required="@field.IsRequired" Immediate="true" />
                                break;
                            case Bones.Api.Client.FieldType.TextBox:
                                <MudTextField T="string" Lines="10" Label="@field.Name" Required="@field.IsRequired" Immediate="true" />
                                break;
                            case Bones.Api.Client.FieldType.Integer:
                                <MudNumericField T="int?" Label="@field.Name" Min="@(field.CanBeNegative ?? true ? null : 0)" Required="@field.IsRequired" Immediate="true" />
                                break;
                            case Bones.Api.Client.FieldType.Decimal:
                                <MudNumericField T="decimal?" Label="@field.Name" Min="@(field.CanBeNegative ?? true ? null : 0)" Required="@field.IsRequired" Immediate="true" />
                                break;
                            case Bones.Api.Client.FieldType.Boolean:
                                @if (field.IsRequired)
                                {
                                    <MudCheckBox T="bool" Label="@field.Name" Required="true" />
                                }
                                else
                                {
                                    <MudCheckBox T="bool?" TriState="true" Label="@field.Name" />
                                }
                                break;
                            case Bones.Api.Client.FieldType.DateTime:
                                <MudInputLabel>@field.Name</MudInputLabel>
                                <MudDatePicker T="DateOnly?" Required="@field.IsRequired" />
                                <MudTimePicker T="TimeOnly?" Required="@field.IsRequired" />
                                break;
                            case Bones.Api.Client.FieldType.ValueList:
                                <MudSelect T="string" Label="@field.Name" Required="@field.IsRequired" Immediate="true">
                                    @foreach (string value in field.PossibleValues)
                                    {
                                        <MudSelectItem Value="@value">@value</MudSelectItem>
                                    }
                                </MudSelect>
                                break;                        
                            default:
                                <MudText Typo="Typo.body1">Unsupported field type: @field.Type</MudText>
                                break;
                        }
                    }
                    <div style="align-self: end;">
                        <br />
                        <a onclick="history.back();">
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary">Cancel</MudButton>
                        </a>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!FormValid)" Class="ml-auto" OnClick="@SendCreateRequestAsync">Create</MudButton>
                    </div>
                </MudForm>
            </MudPaper>
        }
    </MudItem>
    <MudItem xs="12" sm="5">
        <MudItem Class="pa-2" hidden="@(!ApiError)">
            <MudAlert Severity="Severity.Error">There was an error with the creation, please try again.</MudAlert>
        </MudItem>
    
        @foreach (string error in ValidationErrors)
        {
            <MudItem Class="pa-2">
                <MudAlert  Severity="Severity.Error">@error</MudAlert>
            </MudItem>
        }
    </MudItem>
</MudGrid>