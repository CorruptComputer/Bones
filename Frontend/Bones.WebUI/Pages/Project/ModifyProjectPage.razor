@using Bones.WebUI.Components.Project.Modify
@attribute [Route(FrontEndUrls.Project.MODIFY_PROJECT)]

<MudText Typo="Typo.h4">Modify Project</MudText>

<MudPaper Class="pa-4">
    <!-- TODO: figure out a better way to display this, it kinda looks like ass -->
    <a onclick="history.back();">
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary">Go back</MudButton>
    </a>

    <MudText>Project Name: @ProjectName</MudText>
    <MudText>Owner Name: @OwnerName</MudText>

    <MudTabs Outlined="true"
             Position="Position.Left"
             Rounded="true"
             Border="true"
             ApplyEffectsToContainer="true"
             Class="mt-8"
             PanelClass="pa-6">

        <MudTabPanel Text="Fields">
            <ProjectFieldsSummary ProjectId="@ProjectId" />
        </MudTabPanel>
        <MudTabPanel Text="Assignments">
            <MudText>Assignments</MudText>
        </MudTabPanel>
        <MudTabPanel Text="Layouts">
            <ProjectLayoutsSummary ProjectId="@ProjectId" />
        </MudTabPanel>
        <MudTabPanel Text="Permissions">
            <MudText>Permissions</MudText>
        </MudTabPanel>
    </MudTabs>
</MudPaper>
