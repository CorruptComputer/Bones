@attribute [Route(FrontEndUrls.Project.MODIFY_PROJECT)]

<MudText Typo="Typo.h4">Modify Project</MudText>

<MudPaper Class="pa-4">
    <!-- TODO: figure out a better way to display this, it kinda looks like ass -->
    <a onclick="history.back();">
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary">Go back</MudButton>
    </a>

    <MudText>Project Name: @ProjectName</MudText>
    <MudText>Owner Name: @OwnerName</MudText>
</MudPaper>


<div class="d-flex" style="justify-content: space-between;">
    <div style="width:49%">
        <div class="d-flex">
            <MudText Typo="Typo.h4">Project Fields</MudText>
            <MudSpacer/>
            <MudButton Href="@GetCreateItemFieldUrl(ProjectId)">Create Field</MudButton>
        </div>

        <MudPaper Class="pa-4">
            <MudText>Number of fields: @ItemFieldsCount</MudText>

            <MudTable Items="@ItemFieldsList" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@ItemFieldsListLoading" LoadingProgressColor="Color.Info">
                <HeaderContent>
                    <MudTh>Field Name</MudTh>
                    <MudTh>Is Required?</MudTh>
                    <MudTh>Field Type</MudTh>
                    <MudTh>Edit Field</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Field Name">@context.Name</MudTd>
                    <MudTd DataLabel="Is Required?">@context.IsRequired</MudTd>
                    <MudTd DataLabel="Field Type">@context.Type</MudTd>
                    <MudTd DataLabel="Edit Field"><MudButton Href="@GetEditItemFieldUrl(ProjectId, context.ItemFieldId)">Edit</MudButton></MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </div>
    <div style="width:49%">
        <div class="d-flex">
            <MudText Typo="Typo.h4">Project Layouts</MudText>
            <MudSpacer/>
            <MudButton Href="@GetCreateItemLayoutUrl(ProjectId)">Create Layout</MudButton>
        </div>

        <MudPaper Class="pa-4">
            <MudText>Number of layouts: @ItemLayoutsCount</MudText>

            <MudTable Items="@ItemLayoutsList" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@ItemLayoutsListLoading" LoadingProgressColor="Color.Info">
                <HeaderContent>
                    <MudTh>Layout Name</MudTh>
                    <MudTh>Enabled For</MudTh>
                    <MudTh>Edit Layout</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Layout Name">@context.Name</MudTd>
                    <MudTd DataLabel="Enabled For">@context.EnabledFor</MudTd>
                    <MudTd DataLabel="Edit Layout"><MudButton Href="@GetEditItemLayoutUrl(ProjectId, context.ItemLayoutId)">Edit</MudButton></MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </div>
</div>

<!-- TODO: Going to also need Role and Assignment settings here for Organizations once those start getting implemented -->