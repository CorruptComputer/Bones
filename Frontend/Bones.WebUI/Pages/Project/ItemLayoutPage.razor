@attribute [Route(FrontEndUrls.Project.ItemLayout.ITEM_LAYOUT)]

<MudText Typo="Typo.h4">@TitleText</MudText>

<MudForm @ref="@Form" @bind-IsValid="@FormValid" @bind-Errors="@ValidationErrors">
    <MudTextField T="string" Label="Layout Name" Required="true" RequiredError="Layout name is required!" @bind-value="@LayoutName"/>

    <MudSelect T="Bones.Api.Client.AutoGen.Models.ItemLayoutUse" Label="Item Layout Use" Required="true" RequiredError="Item Layout Use is required!" @bind-value="@LayoutUse">
        <MudSelectItem Value="Bones.Api.Client.AutoGen.Models.ItemLayoutUse.Assets">Asset</MudSelectItem>
        <MudSelectItem Value="Bones.Api.Client.AutoGen.Models.ItemLayoutUse.Tasks">Task</MudSelectItem>
    </MudSelect>

    @if (ItemLayoutId.HasValue)
    {
        <MudTextField T="string" Label="ID Prefix (cannot be changed)" MaxLength="6" Disabled @bind-value="@FriendlyIdPrefix"/>
    }
    else
    {
        <MudTextField T="string" Label="ID Prefix (must be unique within your project)" Required="true" RequiredError="ID Prefix is required!" MaxLength="6" @bind-value="@FriendlyIdPrefix"/>
    }

    <br />

    <div style="display: flex; justify-content: space-between;">
        <div style="width:49%">
            <MudText Typo="Typo.h5">Available Fields</MudText>

            <MudTable Items="@ItemFieldsList.Where(f => !SelectedItemFields.Values.Any(s => s.FieldVersionId == f.FieldVersionId))" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@ItemFieldsListLoading" LoadingProgressColor="Color.Info">
                <HeaderContent>
                    <MudTh>Controls</MudTh>
                    <MudTh>Field Name</MudTh>
                    <MudTh>Is Required?</MudTh>
                    <MudTh>Field Type</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Controls">
                        <div style="display: flex;">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Add" aria-label="add" OnClick="@(async () => await AddFieldAsync(context.FieldVersionId))" />
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Field Name">@context.Name</MudTd>
                    <MudTd DataLabel="Is Required?">@context.IsRequired</MudTd>
                    <MudTd DataLabel="Field Type">@context.Type</MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="@TableConsts.PageSizeOptions" />
                </PagerContent>
            </MudTable>
        </div>
        <div style="width:49%">
            <MudText Typo="Typo.h5">Added Fields</MudText>

            <MudTable Items="@SelectedItemFields.OrderBy(s => s.Key)" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@SelectedItemFieldsLoading" LoadingProgressColor="Color.Info">
                <HeaderContent>
                    <MudTh>Controls</MudTh>
                    <MudTh>Field Name</MudTh>
                    <MudTh>Is Required?</MudTh>
                    <MudTh>Field Type</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Controls">
                        <div style="display: flex;">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.ArrowUpward" Color="Color.Primary" aria-label="move up" OnClick="@(async () => await MoveFieldUpAsync(context.Value.FieldVersionId))" />
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.ArrowDownward" Color="Color.Primary" aria-label="move down" OnClick="@(async () => await MoveFieldDownAsync(context.Value.FieldVersionId))" />
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete" aria-label="remove" OnClick="@(async () => await RemoveFieldAsync(context.Value.FieldVersionId))" />
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Field Name">@context.Value.Name</MudTd>
                    <MudTd DataLabel="Is Required?">@context.Value.IsRequired</MudTd>
                    <MudTd DataLabel="Field Type">@context.Value.Type</MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="@TableConsts.PageSizeOptions" />
                </PagerContent>
            </MudTable>

            <MudNumericField Label="Field Count" Required ReadOnly @bind-Value="@SelectedItemFieldsCount" />
        </div>
    </div>
    <div style="display: flex; justify-content: space-between;">
        <div style="width:49%">
            <MudText Typo="Typo.h5">Assignee Slot</MudText>

            <MudTextField T="string" Label="Name" @bind-value="@NewAssigneeName"/>

            <MudSelect T="Bones.Api.Client.AutoGen.Models.AssignmentType" Label="Assignment Type" @bind-value="@NewAssigneeAssignmentType">
                <MudSelectItem Value="Bones.Api.Client.AutoGen.Models.AssignmentType.User">User</MudSelectItem>
                <MudSelectItem Value="Bones.Api.Client.AutoGen.Models.AssignmentType.Role">Role</MudSelectItem>
            </MudSelect>

            <MudSelect T="Bones.Api.Client.AutoGen.Models.SelectionType" Label="Selection Type" @bind-value="@NewAssigneeSelectionType">
                <MudSelectItem Value="Bones.Api.Client.AutoGen.Models.SelectionType.Single">Single</MudSelectItem>
                <MudSelectItem Value="Bones.Api.Client.AutoGen.Models.SelectionType.Multiple">Multiple</MudSelectItem>
            </MudSelect>

            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Add" aria-label="add" OnClick="@(async () => await AddAssigneeAsync())" />

            <MudTable Items="@ItemAssigneesList" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@ItemAssigneesListLoading" LoadingProgressColor="Color.Info">
                <HeaderContent>
                    <MudTh>Controls</MudTh>
                    <MudTh>Name</MudTh>
                    <MudTh>Assignment Type</MudTh>
                    <MudTh>Selection Type</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Controls">
                        <MudTd DataLabel="Controls">
                            <div style="display: flex;">
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.ArrowUpward" Color="Color.Primary" aria-label="move up" OnClick="@(async () => await MoveAssigneeUpAsync(context.Name))" />
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.ArrowDownward" Color="Color.Primary" aria-label="move down" OnClick="@(async () => await MoveAssigneeDownAsync(context.Name))" />
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete" aria-label="remove" OnClick="@(async () => await RemoveAssigneeAsync(context.Name))" />
                            </div>
                        </MudTd>
                    </MudTd>
                    <MudTd DataLabel="Name">@context.Name</MudTd>
                    <MudTd DataLabel="Assignment Type">@context.AssignmentType</MudTd>
                    <MudTd DataLabel="Selection Type">@context.SelectionType</MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="@TableConsts.PageSizeOptions" />
                </PagerContent>
            </MudTable>
        </div>
        <div style="width:49%">

        </div>
    </div>

    <div style="align-self: end;">
        <br />
        <a onclick="history.back();">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary">Cancel</MudButton>
        </a>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!FormValid)" Class="ml-auto" OnClick="@SendCreateRequestAsync">
            @SaveButtonText
        </MudButton>
    </div>
</MudForm>

