@attribute [Route(FrontEndUrls.Project.ItemField.CREATE_FIELD)]

<h3>Create Item Field</h3>
<MudGrid>
    <MudItem xs="12" sm="7">
        <MudPaper Class="pa-4">
            <MudForm @bind-IsValid="@FormValid" @bind-Errors="@ValidationErrors">
                <MudTextField T="string" Label="Field Name" Required="true" RequiredError="Field name is required!" @bind-value="@FieldName"/>

                <MudSelect T="Api.Client.FieldType" Label="Field Type" Required="true" RequiredError="Field type is required!" @bind-value="@FieldType">
                    <MudSelectItem Value="Api.Client.FieldType.Text">Text</MudSelectItem>
                    <MudSelectItem Value="Api.Client.FieldType.Integer">Integer</MudSelectItem>
                    <MudSelectItem Value="Api.Client.FieldType.Decimal">Decimal</MudSelectItem>
                    <MudSelectItem Value="Api.Client.FieldType.Boolean">Boolean</MudSelectItem>
                    <MudSelectItem Value="Api.Client.FieldType.DateTime">Date Time</MudSelectItem>
                    <MudSelectItem Value="Api.Client.FieldType.ValueList">Value List</MudSelectItem>
                    <MudSelectItem Value="Api.Client.FieldType.GeoLocation">Geo Location</MudSelectItem>
                </MudSelect>

                @if (FieldType == Api.Client.FieldType.ValueList)
                {
                    <!-- TODO: Add boxes for them to add values to this -->
                }
                else if (FieldType == Api.Client.FieldType.GeoLocation)
                {
                    <MudSelect T="Api.Client.GeoLocationType" Label="Geo Location Type" Required="true" RequiredError="Geo Location type is required!" @bind-value="@GeoLocationType">
                        <MudSelectItem Value="Api.Client.GeoLocationType.OsmObject">OsmObject</MudSelectItem>
                        <MudSelectItem Value="Api.Client.GeoLocationType.LatLon">LatLon</MudSelectItem>
                        <MudSelectItem Value="Api.Client.GeoLocationType.Address">Address</MudSelectItem>
                        <MudSelectItem Value="Api.Client.GeoLocationType.Geometry">Geometry</MudSelectItem>
                    </MudSelect>
                }
                else if (FieldType == Api.Client.FieldType.Decimal || FieldType == Api.Client.FieldType.Integer)
                {
                    <MudCheckBox T="bool" Label="Can be negative?" @bind-value="@CanBeNegative"/>
                }

                @if (GeoLocationType == Api.Client.GeoLocationType.Address)
                {
                    <MudCheckBox T="bool" Label="Street number required?" @bind-value="@StreetNumberRequired"/>
                    <MudCheckBox T="bool" Label="Street name required?" @bind-value="@StreetNameRequired"/>
                    <MudCheckBox T="bool" Label="City or Place required?" @bind-value="@CityOrPlaceRequired"/>
                    <MudCheckBox T="bool" Label="State or Province required?" @bind-value="@StateOrProvinceRequired"/>
                    <MudCheckBox T="bool" Label="Postal code required?" @bind-value="@PostalCodeRequired"/>
                    <MudCheckBox T="bool" Label="County required?" @bind-value="@CountyRequired"/>
                    <MudCheckBox T="bool" Label="Country required?" @bind-value="@CountryRequired"/>
                }
                

                <MudCheckBox T="bool" Label="Is Required?" @bind-value="@IsRequired"/>

                <div class="d-flex align-center justify-space-between">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!FormValid)" Class="ml-auto" OnClick="@SendCreateRequestAsync">Create</MudButton>
                </div>
            </MudForm>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="5">
        <MudItem Class="pa-2" hidden="@(!ApiError)">
            <MudAlert Severity="Severity.Error">There was an error with the creation, please try again.</MudAlert>
        </MudItem>
    
        @foreach (string error in ValidationErrors)
        {
            <MudItem Class="pa-2">
                <MudAlert  Severity="Severity.Error">@error</MudAlert>
            </MudItem>
        }
    </MudItem>
</MudGrid>