@attribute [Route(FrontEndUrls.Project.CREATE)]

<MudText Typo="Typo.h4">Create Project</MudText>
<MudGrid>
    <MudItem xs="12" sm="7">
        <MudPaper Class="pa-4">
            <MudForm @bind-IsValid="@FormValid" @bind-Errors="@ValidationErrors">
                <MudTextField T="string" Label="Project Name" Required="true" RequiredError="Project name is required!" @bind-Value="@ProjectName" Immediate="true" />

                <MudSelect T="ProjectPreset?" Label="Preset" @bind-value="@projectPreset">
                    <MudSelectItem T="ProjectPreset?" Value="null">None</MudSelectItem>
                    <MudSelectItem T="ProjectPreset?" Value="ProjectPreset.Development">Development</MudSelectItem>
                </MudSelect>

                <div style="align-self: end;">
                    <br />
                    <a onclick="history.back();">
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary">Cancel</MudButton>
                    </a>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!FormValid)" Class="ml-auto" OnClick="@SendCreateRequestAsync">Create</MudButton>
                </div>
            </MudForm>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="5">
        <MudItem Class="pa-2" hidden="@(!ApiError)">
            <MudAlert Severity="Severity.Error">There was an error with the Project creation, please try again.</MudAlert>
        </MudItem>

        @foreach (string error in ValidationErrors)
        {
            <MudItem Class="pa-2">
                <MudAlert  Severity="Severity.Error">@error</MudAlert>
            </MudItem>
        }
    </MudItem>
</MudGrid>