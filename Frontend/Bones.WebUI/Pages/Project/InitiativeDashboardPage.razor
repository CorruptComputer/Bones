@attribute [Route(FrontEndUrls.Project.Initiative.INITIATIVE_DASHBOARD)]

<MudText Typo="Typo.h4">Initiative Dashboard</MudText>
<MudPaper Class="pa-4">
    <MudText>Initiative Name: @InitiativeName</MudText>
</MudPaper>

<div class="d-flex">
    <MudText Typo="Typo.h4">Queues</MudText>
    <MudSpacer/>
    <MudButton Href="@FrontEndUrls.Project.Initiative.INITIATIVE_CREATE_WORKITEM_QUEUE.Replace(FrontEndUrls.Project.PROJECT_ID_PLACEHOLDER, ProjectId.ToString()).Replace("{InitiativeId:guid}", InitiativeId.ToString())">Create Work Item Queue</MudButton>
</div>


<MudPaper Class="pa-4">
    <MudText>Number of Work Item queues: @QueueCount</MudText>

    <MudTable Items="@QueueList" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@QueueListLoading" LoadingProgressColor="Color.Info">
        <HeaderContent>
            <MudTh>Work Item Queue Name</MudTh>
            <MudTh>Work Item Count</MudTh>
            <MudTh>Go to Work Item Queue</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Work Item Queue Name">@context.WorkItemQueueName</MudTd>
            <MudTd DataLabel="Work Item Count">@context.WorkItemCount</MudTd>
            <MudTd DataLabel="Go to Work Item Queue"><MudButton Href="@FrontEndUrls.WorkItem.WORKITEM_QUEUE_DASHBOARD.Replace(FrontEndUrls.Project.PROJECT_ID_PLACEHOLDER, ProjectId.ToString()).Replace("{WorkItemQueueId:guid}", context.WorkItemQueueId.ToString())">Dashboard</MudButton></MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>