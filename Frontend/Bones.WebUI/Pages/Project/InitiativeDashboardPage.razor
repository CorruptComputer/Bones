@attribute [Route(FrontEndUrls.Project.Initiative.INITIATIVE_DASHBOARD)]

<div style="display: flex;">
    <MudText Typo="Typo.h4">@InitiativeName</MudText>
    <MudSpacer/>
    <MudButton Href="@FrontEndUrls.Project.Initiative.INITIATIVE_CREATE_TASK_QUEUE.Replace("{InitiativeId:guid}", InitiativeId.ToString())">Create Task Queue</MudButton>
</div>


<MudPaper Class="pa-4">
    <MudText>Number of Task queues: @TaskQueueCount</MudText>

    <MudTable Items="@TaskQueueList" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@TaskQueueListLoading" LoadingProgressColor="Color.Info">
        <HeaderContent>
            <MudTh>Task Queue Name</MudTh>
            <MudTh>Task Count</MudTh>
            <MudTh>Go to Task Queue</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Task Queue Name">@context.TaskQueueName</MudTd>
            <MudTd DataLabel="Task Count">@context.TaskCount</MudTd>
            <MudTd DataLabel="Go to Task Queue"><MudButton Href="@FrontEndUrls.Task.TASK_QUEUE_DASHBOARD.Replace("{TaskQueueId:guid}", context.TaskQueueId.ToString())">Dashboard</MudButton></MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>