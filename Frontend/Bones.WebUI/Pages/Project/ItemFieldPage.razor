@attribute [Route(FrontEndUrls.Project.ItemField.ITEM_FIELD)]

<MudText Typo="Typo.h4">@TitleText</MudText>
<MudGrid>
    <MudItem xs="12" sm="7">
        <MudPaper Class="pa-4">
            <MudForm @bind-IsValid="@FormValid" @bind-Errors="@ValidationErrors">
                <MudTextField T="string" Label="Field Name" Required="true" RequiredError="Field name is required!" @bind-value="@FieldName" Immediate="true" />

                <MudSelect T="Bones.Api.Client.AutoGen.Models.FieldType" Label="Field Type" Required="true" RequiredError="Field type is required!" @bind-value="@FieldType">
                    <MudSelectItem Value="Bones.Api.Client.AutoGen.Models.FieldType.TextField">Short Text</MudSelectItem>
                    <MudSelectItem Value="Bones.Api.Client.AutoGen.Models.FieldType.TextBox">Long Text</MudSelectItem>
                    <MudSelectItem Value="Bones.Api.Client.AutoGen.Models.FieldType.Integer">Integer</MudSelectItem>
                    <MudSelectItem Value="Bones.Api.Client.AutoGen.Models.FieldType.Decimal">Decimal</MudSelectItem>
                    <MudSelectItem Value="Bones.Api.Client.AutoGen.Models.FieldType.Boolean">Boolean</MudSelectItem>
                    <MudSelectItem Value="Bones.Api.Client.AutoGen.Models.FieldType.DateTime">Date Time</MudSelectItem>
                    <MudSelectItem Value="Bones.Api.Client.AutoGen.Models.FieldType.ValueList">Value List</MudSelectItem>
                    <!-- disabled for now, not yet figured out how I want to handle it. Rest should all work -->
                    <!--MudSelectItem Value="Bones.Api.Client.AutoGen.Models.FieldType.GeoLocation">Geo Location</MudSelectItem-->
                </MudSelect>

                @if (FieldType == Bones.Api.Client.AutoGen.Models.FieldType.ValueList)
                {
                    <!-- TODO: Add boxes for them to add values to this -->
                }
                else if (FieldType == Bones.Api.Client.AutoGen.Models.FieldType.GeoLocation)
                {
                    <MudSelect T="GeoLocationType" Label="Geo Location Type" Required="true" RequiredError="Geo Location type is required!" @bind-value="@GeoLocationType">
                        <MudSelectItem Value="GeoLocationType.OsmObject">OsmObject</MudSelectItem>
                        <MudSelectItem Value="GeoLocationType.LatLon">LatLon</MudSelectItem>
                        <MudSelectItem Value="GeoLocationType.Address">Address</MudSelectItem>
                        <MudSelectItem Value="GeoLocationType.Geometry">Geometry</MudSelectItem>
                    </MudSelect>
                }
                else if (FieldType == Bones.Api.Client.AutoGen.Models.FieldType.Decimal || FieldType == Bones.Api.Client.AutoGen.Models.FieldType.Integer)
                {
                    <MudCheckBox Label="Can be negative?" @bind-value="@CanBeNegative"/>
                }

                @if (GeoLocationType == GeoLocationType.Address)
                {
                    <MudCheckBox Label="Street number required?" @bind-value="@StreetNumberRequired"/>
                    <MudCheckBox Label="Street name required?" @bind-value="@StreetNameRequired"/>
                    <MudCheckBox Label="City or Place required?" @bind-value="@CityOrPlaceRequired"/>
                    <MudCheckBox Label="State or Province required?" @bind-value="@StateOrProvinceRequired"/>
                    <MudCheckBox Label="Postal code required?" @bind-value="@PostalCodeRequired"/>
                    <MudCheckBox Label="County required?" @bind-value="@CountyRequired"/>
                    <MudCheckBox Label="Country required?" @bind-value="@CountryRequired"/>
                }

                <MudCheckBox Label="Is Required?" @bind-value="@IsRequired"/>

                <div style="align-self: end;">
                    <br />
                    <a onclick="history.back();">
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary">Cancel</MudButton>
                    </a>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!FormValid)" Class="ml-auto" OnClick="@SendCreateRequestAsync">@SaveButtonText</MudButton>
                </div>
            </MudForm>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="5">
        <MudItem Class="pa-2" hidden="@(!ApiError)">
            <MudAlert Severity="Severity.Error">There was an error with the creation, please try again.</MudAlert>
        </MudItem>

        @foreach (string error in ValidationErrors)
        {
            <MudItem Class="pa-2">
                <MudAlert  Severity="Severity.Error">@error</MudAlert>
            </MudItem>
        }
    </MudItem>
</MudGrid>