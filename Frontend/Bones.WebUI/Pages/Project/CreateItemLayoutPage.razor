@attribute [Route(FrontEndUrls.Project.ItemLayout.CREATE_LAYOUT)]

<MudText Typo="Typo.h4">Create Item Layout</MudText>

<MudPaper Class="pa-7">
    <MudForm @bind-IsValid="@FormValid" @bind-Errors="@ValidationErrors">
        <MudTextField T="string" Label="Layout Name" Required="true" RequiredError="Layout name is required!" @bind-value="@LayoutName"/>
        <MudText>Enabled For</MudText>
        <div class="d-flex">
            <MudCheckBox T="bool" Label="WorkItems" @bind-value="@EnabledForWorkItems"/>
            <MudCheckBox T="bool" Label="Assets" @bind-value="@EnabledForAssets"/>
        </div>
        <MudTextField T="string" Label="ID Prefix (must be unique within your project)" Required="true" RequiredError="ID Prefix is required!" MaxLength="6" @bind-value="@FriendlyIdPrefix"/>

        <div class="d-flex" style="justify-content: space-between;">
            <div style="width:49%">
                <MudText Typo="Typo.h4">Available Fields</MudText>

                <MudPaper Class="pa-4">
                    <MudTable Items="@ItemFieldsList.Where(f => !SelectedItemFields.Contains(f.FieldVersionId))" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@ItemFieldsListLoading" LoadingProgressColor="Color.Info">
                        <HeaderContent>
                            <MudTh>Field Name</MudTh>
                            <MudTh>Is Required?</MudTh>
                            <MudTh>Field Type</MudTh>
                            <MudTh>Add Field</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Field Name">@context.Name</MudTd>
                            <MudTd DataLabel="Is Required?">@context.IsRequired</MudTd>
                            <MudTd DataLabel="Field Type">@context.Type</MudTd>
                            <MudTd DataLabel="Add Field"><MudButton OnClick="@(() => AddField_OnClick(context.FieldVersionId))">Add</MudButton></MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            </div>
            <div style="width:49%">
                <MudText Typo="Typo.h4">Added Fields</MudText>

                <MudPaper Class="pa-4">
                    <MudTable Items="@ItemFieldsList.Where(f => SelectedItemFields.Contains(f.FieldVersionId))" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@ItemFieldsListLoading" LoadingProgressColor="Color.Info">
                        <HeaderContent>
                            <MudTh>Field Name</MudTh>
                            <MudTh>Is Required?</MudTh>
                            <MudTh>Field Type</MudTh>
                            <MudTh>Remove Field</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Field Name">@context.Name</MudTd>
                            <MudTd DataLabel="Is Required?">@context.IsRequired</MudTd>
                            <MudTd DataLabel="Field Type">@context.Type</MudTd>
                            <MudTd DataLabel="Remove Field"><MudButton OnClick="@(() => RemoveField_OnClick(context.FieldVersionId))">Remove</MudButton></MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            </div>
        </div>
        
        <div style="align-self: end;">
            <br />
            <a onclick="history.back();">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary">Cancel</MudButton>
            </a>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!FormValid)" Class="ml-auto" OnClick="@SendCreateRequestAsync">Create</MudButton>
        </div>
    </MudForm>
    <MudItem xs="12" sm="5">
        <MudItem Class="pa-2" hidden="@(!ApiError)">
            <MudAlert Severity="Severity.Error">There was an error with the creation, please try again.</MudAlert>
        </MudItem>
    
        @foreach (string error in ValidationErrors)
        {
            <MudItem Class="pa-2">
                <MudAlert  Severity="Severity.Error">@error</MudAlert>
            </MudItem>
        }
    </MudItem>
</MudPaper>
