@attribute [Route(FrontEndUrls.Project.PROJECT_DASHBOARD)]

<div style="display: flex;">
    <MudText Typo="Typo.h4">@ProjectName</MudText>
    <MudSpacer/>
    <MudButton Href="@FrontEndUrls.Project.MODIFY_PROJECT.Replace(FrontEndUrls.Project.PROJECT_ID_PLACEHOLDER, ProjectId.ToString())">Modify Project</MudButton>
</div>

<MudPaper Class="pa-4">
    <MudText>Bleep bloop I'm some information about '@ProjectName'</MudText>

    <MudText Typo="Typo.h5">Asset Dashboards</MudText>
    <MudStack Row="true">
        @foreach (AssetTypesListModel assetType in AssetTypes)
        {
            <MudButton ButtonType="ButtonType.Button" Variant="Variant.Outlined" Href="@FrontEndUrls.Asset.ASSET_LAYOUT_DASHBOARD.Replace(FrontEndUrls.Asset.ASSET_LAYOUT_ID_PLACEHOLDER, assetType.LayoutId.ToString())">@assetType.LayoutName</MudButton>
        }
    </MudStack>
</MudPaper>

<br />

<div style="display: flex;">
    <MudText Typo="Typo.h4">Initiatives</MudText>
    <MudSpacer/>
    <MudButton Href="@FrontEndUrls.Project.CREATE_INITIATIVE.Replace(FrontEndUrls.Project.PROJECT_ID_PLACEHOLDER, ProjectId.ToString())">Create Initiative</MudButton>
</div>

<MudPaper Class="pa-4">
    <MudText>Number of initiatives: @InitiativeCount</MudText>

    <MudTable Items="@InitiativeList" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@InitiativeListLoading" LoadingProgressColor="Color.Info">
        <HeaderContent>
            <MudTh>Initiative Name</MudTh>
            <MudTh>Queue Count</MudTh>
            <MudTh>Go to Initiative</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Initiative Name">@context.InitiativeName</MudTd>
            <MudTd DataLabel="Queue Count">@context.QueueCount</MudTd>
            <MudTd DataLabel="Go to Initiative"><MudButton Href="@FrontEndUrls.Project.Initiative.INITIATIVE_DASHBOARD.Replace(FrontEndUrls.Project.PROJECT_ID_PLACEHOLDER, ProjectId.ToString()).Replace("{InitiativeId:guid}", context.InitiativeId.ToString())">Dashboard</MudButton></MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>