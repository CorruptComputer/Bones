@attribute [Route(FrontEndUrls.Project.PROJECT_DASHBOARD)]
@inject ILogger<ProjectDashboardPage> Logger

<div class="d-flex">
    <MudText Typo="Typo.h4">Project Dashboard</MudText>
    <MudSpacer/>
    <MudButton Href="@FrontEndUrls.Project.MODIFY_PROJECT.Replace("{ProjectId:guid}", ProjectId.ToString())">Modify Project</MudButton>
</div>

<MudPaper Class="pa-4">
    <MudText>Project Name: @ProjectName</MudText>
    <MudText>Owner Name: @OwnerName</MudText>
</MudPaper>

<div class="d-flex">
    <MudText Typo="Typo.h4">Initiatives</MudText>
    <MudSpacer/>
    <MudButton Href="@FrontEndUrls.Project.Initiative.CREATE_INITIATIVE.Replace("{ProjectId:guid}", ProjectId.ToString())">Create Initiative</MudButton>
</div>


<MudPaper Class="pa-4">
    <MudText>Number of initiatives: @InitiativeCount</MudText>

    <MudTable Items="@InitiativeList" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@InitiativeListLoading" LoadingProgressColor="Color.Info">
        <HeaderContent>
            <MudTh>Initiative Name</MudTh>
            <MudTh>Queue Count</MudTh>
            <MudTh>Go to Initiative</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Initiative Name">@context.InitiativeName</MudTd>
            <MudTd DataLabel="Queue Count">@context.QueueCount</MudTd>
            <MudTd DataLabel="Go to Initiative"><MudButton Href="@FrontEndUrls.Project.Initiative.INITIATIVE_DASHBOARD.Replace("{ProjectId:guid}", ProjectId.ToString()).Replace("{InitiativeId:guid}", context.InitiativeId.ToString())">Dashboard</MudButton></MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>