@using Bones.WebUI.Models

<MudPaper Class="pa-4">
    @if (_apiError)
    {
        <MudAlert Severity="Severity.Error">Error loading assignments</MudAlert>
    }
    else if (_assignmentSlots.Count == 0)
    {
        <MudText Typo="Typo.body1">No assignment slots for this item</MudText>
    }
    else
    {
        @foreach (AssignmentSlotModel slot in _assignmentSlots.OrderBy(s => s.OrderIndex))
        {
            <MudCard Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">@slot.AssignmentSlotName</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_slotAssignees[slot].Count == 0)
                    {
                        <MudText Typo="Typo.body2">No assignees in this slot</MudText>
                    }
                    else
                    {
                        <MudTable Items="@_slotAssignees[slot]" Hover="true" Breakpoint="Breakpoint.Sm">
                            <HeaderContent>
                                <MudTh>Assigned To</MudTh>
                                <MudTh>State</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Assigned To">@context.AssigneeDisplayName</MudTd>
                                <MudTd DataLabel="State">@context.AssignmentState</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudCardContent>
            </MudCard>
        }
    }
</MudPaper>