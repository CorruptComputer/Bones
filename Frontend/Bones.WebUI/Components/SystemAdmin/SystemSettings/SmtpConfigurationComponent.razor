<MudPaper Class="pa-4">
    <MudText Typo="Typo.h5">SMTP Configuration</MudText>

    <MudForm @bind-IsValid="@FormValid" @bind-Errors="@ValidationErrors">
        <MudCheckBox Label="Enable SMTP" @bind-value="@IsEnabled" />
        
        <MudTextField T="string" Label="Server" @bind-value="@Server" 
                        InputType="InputType.Text" Required="true" RequiredError="Server is required!" />

        <MudTextField T="string" Label="Port" @bind-value="@Port"
                        InputType="InputType.Number" Required="true" RequiredError="Port is required!" />

        <MudCheckBox Label="Use SSL" @bind-value="@UseSsl" />
        <MudTextField T="string" Label="Username" @bind-value="@Username" InputType="InputType.Text" />
        <MudTextField T="string" Label="Password" @bind-value="@Password" InputType="InputType.Password" />
        <MudTextField T="string" Label="From Email" @bind-value="@FromAddress" InputType="InputType.Email" />
        <MudTextField T="string" Label="From Name" @bind-value="@FromName" InputType="InputType.Text" />

        <div style="display: flex;">
            <MudTextField T="string" Label="Reason for change" @bind-value="@ChangeReason"
                        InputType="InputType.Text" Required="true" RequiredError="Change reason is required!"/>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!FormValid)" Class="ml-auto" OnClick="@Update">Update</MudButton>
        </div>
    </MudForm>
</MudPaper>
