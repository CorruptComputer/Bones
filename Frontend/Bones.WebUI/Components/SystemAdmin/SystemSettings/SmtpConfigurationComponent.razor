<MudPaper Class="pa-4">
    <MudText Typo="Typo.h5">SMTP Configuration</MudText>

    <BonesForm Model="@Model" OnSubmit="Update" SubmitText="Update" ShowGoBack="false">
        <MudCheckBox Label="Enable SMTP" @bind-value="@Model.IsEnabled" />
        
        <BonesTextField Label="Server" InputType="InputType.Text" @bind-Value="@Model.Server" />
        <BonesTextField Label="Port" InputType="InputType.Number" @bind-Value="@Model.Port" />

        <MudCheckBox Label="Use SSL" @bind-value="@Model.UseSsl" />
        <BonesTextField Label="Username" InputType="InputType.Text" @bind-Value="@Model.Username" />
        <BonesTextField Label="Password" InputType="InputType.Password" @bind-Value="@Model.Password" />
        <BonesTextField Label="From Email" InputType="InputType.Email" @bind-Value="@Model.FromAddress" />
        <BonesTextField Label="From Name" InputType="InputType.Text" @bind-Value="@Model.FromName" />
        <BonesTextField Label="Reason for change" InputType="InputType.Text" @bind-Value="@Model.ChangeReason" />
    </BonesForm>

    @if (ApiError)
    {
        <MudAlert Severity="Severity.Error">There was an error, please try again.</MudAlert>
    }
</MudPaper>
