<MudPaper Class="pa-4">
    <MudText Typo="Typo.h5">Background Service User</MudText>

    <BonesForm Model="@Model" OnSubmit="Update" SubmitText="Update" ShowGoBack="false">
        <BonesTextField Label="Email" InputType="InputType.Email" @bind-Value="@Model.Email" />
        <BonesTextField Label="Display Name" InputType="InputType.Text" @bind-Value="@Model.DisplayName" />
        <BonesTextField Label="Reason for change" InputType="InputType.Text" @bind-Value="@Model.ChangeReason" />
    </BonesForm>

    @if (ApiError)
    {
        <MudAlert Severity="Severity.Error">There was an error, please try again.</MudAlert>
    }
</MudPaper>
