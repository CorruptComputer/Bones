<MudPaper Class="pa-4">
    <MudText Typo="Typo.h5">Web UI Base URL</MudText>

    <BonesForm Model="@Model" OnSubmit="Update" SubmitText="Update" ShowGoBack="false">
        <BonesTextField Label="Web UI Base URL" InputType="InputType.Url" @bind-Value="@Model.BaseUrl" />
        <BonesTextField Label="Reason for change" InputType="InputType.Text" @bind-Value="@Model.ChangeReason" />
    </BonesForm>

    @if (ApiError)
    {
        <MudAlert Severity="Severity.Error">There was an error, please try again.</MudAlert>
    }
</MudPaper>