<!-- Specifically not using MudForm here, it doesn't use OnValidSubmit and you have to handle it yourself. 
    I'd rather just do this -->
<EditForm Model="Model" OnValidSubmit="OnSubmit">
    <DataAnnotationsValidator />
    @ChildContent
    <div>
        <br />

        @if(context.GetValidationMessages().Any())
        {
            <MudAlert Severity="Severity.Error">
                <ul style="padding-left: 5px;">
                    @foreach (string message in context.GetValidationMessages())
                    {
                        <li>@message</li>
                    }
                </ul>
            </MudAlert>

            <br />
        }

        <div style="justify-self: right;">
            @if (ShowGoBack)
            {
                <a onclick="history.back();">
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary">@GoBackText</MudButton>
                </a>
            }

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">@SubmitText</MudButton>
        </div>
    </div>
</EditForm>