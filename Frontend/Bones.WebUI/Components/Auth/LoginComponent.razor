<MudGrid>
    <MudItem xs="12" sm="7">
        <MudPaper Class="pa-4">
            <div>
                <MudText Typo="Typo.h4">Hello there!</MudText>
                <MudText>This project is something I am working on in my free time, and I cannot guarantee any sort of stability with it.</MudText>
                <MudText>Also if you're on a mobile device, good luck! I have not started on mobile layouts at all.</MudText>
                <br />
                <MudText>If you'd like to check out the source, it is <MudLink Href="https://github.com/CorruptComputer/Bones">available here</MudLink>.</MudText>
            </div>

            <BonesForm Model="LoginForm" OnSubmit="DoLoginAsync" SubmitText="Login" ShowGoBack="false">
                <BonesTextField Label="Email" InputType="InputType.Email" @bind-Value="@LoginForm.Email" />
                <BonesTextField Label="Password" InputType="InputType.Password" @bind-Value="@LoginForm.Password" />
            </BonesForm>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="5">
        <MudItem Class="pa-2" hidden="@(!ErrorLoggingIn)">
            <MudAlert Severity="Severity.Error">There was an error with the login process, please try again.</MudAlert>
        </MudItem>
    </MudItem>
</MudGrid>
