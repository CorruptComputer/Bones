@if (!RegistrationSuccess)
{
    <MudGrid>
        <MudItem xs="12" sm="7">
            <MudPaper Class="pa-4">
                <BonesForm Model="RegisterForm" OnSubmit="DoRegistrationAsync" SubmitText="Register" ShowGoBack="false">
                    <BonesTextField Label="Email" InputType="InputType.Email" @bind-Value="@RegisterForm.Email" />
                    <BonesTextField Label="Password" InputType="InputType.Password" HelperText="Choose a strong password" @bind-Value="@RegisterForm.Password" />
                    <BonesTextField Label="Password" InputType="InputType.Password" HelperText="Repeat the password" @bind-Value="@RegisterForm.PasswordAgain" />

                    <MudCheckBox T="bool" Required="true" RequiredError="You must agree" Label="I agree!"  />
                </BonesForm>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="5">
            <MudItem Class="pa-2" hidden="@(!RegistrationApiError)">
                <MudAlert Severity="Severity.Error">There was an error with the registration, please try again.</MudAlert>
            </MudItem>
        </MudItem>
    </MudGrid>
}
else
{
    <MudAlert Severity="Severity.Success">Account created successfully, please check your email for a confirmation link.</MudAlert>
}

