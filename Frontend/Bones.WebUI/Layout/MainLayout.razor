@inherits LayoutComponentBase
@inject ILogger<MainLayout> Logger

<!-- TODO: Make a toggle for dark mode on the users profile -->
<MudThemeProvider Theme="@Theme" />
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <!-- Top Nav Bar -->
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer"/>
        <AuthorizeView>
            <Authorized>
                <div>
                    <MudSelect SelectedValuesChanged="OnGoToProjectChanged"
                               Placeholder="Go to project..."
                               KeyDownPreventDefault="true"
                               KeyUpPreventDefault="true"
                               MultiSelection="false"
                               SelectedValues="[]"
                               FullWidth="true"
                               T="Guid?">
                        
                        <MudSelectItem Value="@((Guid?)null)" Disabled="true" Style="height: 1px; margin: 0; padding: 0;"></MudSelectItem>
                        @foreach (ProjectDropDownModel proj in Projects)
                        {
                            <MudSelectItem Value="@proj.ProjectId">@proj.ToString()</MudSelectItem>
                        }
                    </MudSelect>
                </div>
            </Authorized>
        </AuthorizeView>
        
        <MudSpacer/>
        <MudButtonGroup Color="Color.Secondary" Variant="Variant.Filled">
            <AuthorizeView>
                <Authorized>
                    <MudButton Href="@FrontEndUrls.Account.MY_PROFILE">My Profile</MudButton>
                    <MudButton OnClick="@LogoutAsync">Logout</MudButton>
                </Authorized>
                <NotAuthorized>
                    @if(_login) 
                    {
                        <MudButton OnClick="@ToggleLoginRegister">Register</MudButton>
                    }
                    else {
                        <MudButton OnClick="@ToggleLoginRegister">Login</MudButton>
                    }
                </NotAuthorized>
            </AuthorizeView>
        </MudButtonGroup>
    </MudAppBar>
    <!-- Side Bar -->
    <MudDrawer @bind-Open="@_open" Elevation="1">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Bones</MudText>
        </MudDrawerHeader>
        <MudNavMenu>
            <MudNavLink Match="NavLinkMatch.All" href="@FrontEndUrls.HOME">Home</MudNavLink>
            <MudNavLink Match="NavLinkMatch.All" href="/RequiresLogin">Requires Login</MudNavLink>
            <MudNavLink Match="NavLinkMatch.All" href="/TestMapPage">Test Map Page</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <!-- Content -->
    <MudMainContent Class="pt-16 px-16">
        <MudContainer Class="mt-6">
            <AuthorizeView>
                <Authorized>
                    @Body
                </Authorized>
                <NotAuthorized>
                    @if(_login) 
                    {
                        <Bones.WebUI.Components.Auth.LoginComponent />
                    }
                    else {
                        <Bones.WebUI.Components.Auth.RegisterComponent />
                    }
                </NotAuthorized>
            </AuthorizeView>
        </MudContainer>
    </MudMainContent>
</MudLayout>