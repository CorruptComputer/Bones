@using MudExtensions
@using System.Reflection
@inherits LayoutComponentBase

<!-- TODO: Make a toggle for dark mode on the users profile -->
<MudThemeProvider Theme="@Theme" />
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <!-- Top Nav Bar -->
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer"/>
        <AuthorizeView>
            <Authorized>
                <div style="width: 20%;"> <!-- Hack to make this thing not tiny, will fuck up mobile -->
                    <MudSelectExtended SelectedValues="[]"
                                       SelectedValuesChanged="OnGoToProjectChanged"
                                       ItemCollection="@Projects"
                                       KeyDownPreventDefault="true"
                                       KeyUpPreventDefault="true"
                                       SearchBox="true"
                                       SearchBoxAutoFocus="true"
                                       SearchBoxClearable="true"
                                       MultiSelection="false"
                                       AnchorOrigin="Origin.BottomCenter"
                                       HelperText="Project quick select"
                                       T="ProjectDropDownModel"
                                       @ref="_projectSelect" />
                </div>
            </Authorized>
        </AuthorizeView>
        
        <MudSpacer/>
        <MudButtonGroup Color="Color.Secondary" Variant="Variant.Filled">
            <AuthorizeView>
                <Authorized>
                    <MudButton Href="@FrontEndUrls.Account.MY_PROFILE">My Profile</MudButton>
                    <MudButton OnClick="@LogoutAsync">Logout</MudButton>
                </Authorized>
                <NotAuthorized>
                    @if(_login) 
                    {
                        <MudButton OnClick="@ToggleLoginRegister">Register</MudButton>
                    }
                    else {
                        <MudButton OnClick="@ToggleLoginRegister">Login</MudButton>
                    }
                </NotAuthorized>
            </AuthorizeView>
        </MudButtonGroup>
    </MudAppBar>
    <!-- Side Bar -->
    <MudDrawer @bind-Open="@_openDrawer" Elevation="1">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Bones</MudText>
        </MudDrawerHeader>
        <MudNavMenu>
            <MudNavLink Match="NavLinkMatch.All" href="@FrontEndUrls.HOME">Home</MudNavLink>
            <MudNavLink Match="NavLinkMatch.All" href="@FrontEndUrls.WorkItem.CREATE_WORK_ITEM">Create Work Item</MudNavLink>
            <MudNavLink Match="NavLinkMatch.All" href="/TestMapPage">Test Map Page</MudNavLink>
            <AuthorizeView Roles="@SystemRoles.SYSTEM_ADMINISTRATORS">
                <Authorized>
                    <MudNavLink Match="NavLinkMatch.All" href="@FrontEndUrls.SystemAdmin.DASHBOARD">System Admin Dashboard</MudNavLink>
                </Authorized>
            </AuthorizeView>
        </MudNavMenu>
        <MudSpacer />
        <MudText Align="Align.Center" Style="padding: 5px">WebUI Version: @_webUiVersion</MudText>
        <MudText Align="Align.Center" Style="padding: 5px">API Version: @_apiVersion</MudText>
        <MudText Align="Align.Center" Style="padding: 5px"><MudLink href="https://github.com/CorruptComputer/Bones">Source</MudLink></MudText>
    </MudDrawer>
    <!-- Content -->
    <MudMainContent Class="pt-16 px-16">
        <MudContainer Class="mt-6">
            <AuthorizeView>
                <Authorized>
                    @Body
                </Authorized>
                <NotAuthorized>
                    @if(_login) 
                    {
                        <Bones.WebUI.Components.Auth.LoginComponent />
                    }
                    else {
                        <Bones.WebUI.Components.Auth.RegisterComponent />
                    }
                </NotAuthorized>
            </AuthorizeView>
        </MudContainer>
    </MudMainContent>
</MudLayout>